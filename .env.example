# WHT Environment Configuration Template
# Copy this file to .env and configure the values for your deployment environment.

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# JWT Secret Key (CRITICAL: Must be set to a strong random 256-bit secret in production)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=

# Optional Initial Admin Account (only created on startup if explicitly configured)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME="Platform Administrator"

# Database Configuration (Supabase PostgreSQL / Vercel Integration)
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# POSTGRES_URL=
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
